{
	"compilerOptions": {
		"jsx": "react",
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2020"]
	},
	"include": ["*.ts", "*.tsx", "test/*.ts"]
}
